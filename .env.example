# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =========================================================================
#  Zoho OAuth  (required)
# =========================================================================
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# Override only if you use a different Zoho data center:
# ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
# ZOHO_CREATOR_BASE_URL=https://www.zohoapis.com/creator/v2.1
# ZOHO_WORKDRIVE_BASE_URL=https://www.zohoapis.com/workdrive/api/v1
# ZOHO_WORKDRIVE_DOWNLOAD_BASE_URL=https://workdrive.zoho.com/api/v1/download

# =========================================================================
#  Zoho Creator app  (defaults match the HomeCartel setup)
# =========================================================================
# ZOHO_CREATOR_ACCOUNT=homecartel
# ZOHO_CRM_APP=crm
# ZOHO_ENCODING_REPORT=All_Encoding_Requests
# ZOHO_ENCODING_FORM=
# ZOHO_WORKFLOW_APP=workflow-module-creation
# ZOHO_ARCHIVE_REPORT=Archive_Report

# =========================================================================
#  Zoho WorkDrive folders to scan for matching media  (required for matching)
# =========================================================================
# Comma-separated list of WorkDrive folder IDs that will be searched
# (recursively) for files matching each pending product name.
ZOHO_WORKDRIVE_PARENT_FOLDER_IDS=folder_id_1,folder_id_2

# Optional single-folder override (used when *_FOLDER_IDS is empty):
# ZOHO_WORKDRIVE_PARENT_FOLDER_ID=your_folder_id

# Optional global search across the whole team drive:
# ZOHO_WORKDRIVE_GLOBAL_SEARCH_ENABLED=false
# ZOHO_WORKDRIVE_TEAM_ID=your_team_id
# ZOHO_WORKDRIVE_SEARCH_RESULT_LIMIT=25

# =========================================================================
#  Zoho Creator field names  (override only if your form uses different names)
# =========================================================================
# FIELD_PRODUCT_NAME=Product_Name
# FIELD_REQUEST_TYPE=Type_of_Request
# FIELD_REQUEST_STATUS=Request_Status
# FIELD_IMAGE_MEDIA=Actual_Photo1
# FIELD_VIDEO_MEDIA=Video
# FIELD_ACTUAL_MEDIA=
# FIELD_REMARKS=Remarks_Notes
# REQUEST_TYPE_VALUE=Actual Photo
# REQUEST_DONE_VALUE=Done
# REQUEST_OPEN_VALUES=Pending,In progress
# SUCCESS_REMARKS=This is uploaded by Automated
# NOT_FOUND_REMARKS=No matching photo/video found for {product_name}

# =========================================================================
#  Archive report (used to skip products that already passed QC)
# =========================================================================
# ARCHIVE_ITEM_NAME_FIELD=Item_Name
# ARCHIVE_STATUS_FIELD=Pasado_ba_sa_Quality_Check
# ARCHIVE_APPROVED_VALUE=Approve
# ARCHIVE_MEDIA_FIELDS=Image_Upload,Video_Upload

# =========================================================================
#  Polling / throttling
# =========================================================================
# POLL_INTERVAL_SECONDS=45
# API_THROTTLE_SECONDS=0.5
# REQUEST_TIMEOUT_SECONDS=60
# NOT_FOUND_RETRY_HOURS=24
# MAX_PENDING_FETCH=50
# MAX_UPLOAD_FILES_PER_RECORD=15

# =========================================================================
#  WorkDrive listing tuning
# =========================================================================
# WORKDRIVE_LIST_PAGE_SIZE=50
# WORKDRIVE_MAX_PAGES=10
# WORKDRIVE_SEARCH_DEPTH=2
# WORKDRIVE_RECURSIVE_SEARCH_DEPTH=2

# =========================================================================
#  Optional internal video browser  (python -m actual_photo_automation --video-browser)
# =========================================================================
# VIDEO_BROWSER_HOST=127.0.0.1
# VIDEO_BROWSER_PORT=8787
# VIDEO_BROWSER_DEPTH=4
# VIDEO_BROWSER_CACHE_SECONDS=20
# VIDEO_BROWSER_TITLE=HomeCartel WorkDrive Reels
# VIDEO_BROWSER_FOLDER_IDS=folder_id_1,folder_id_2

# =========================================================================
#  Akeneo  (only used by actual_photo_automation.upload_to_akeneo)
# =========================================================================
# AKENEO_HOST=http://your.akeneo.host
# AKENEO_CLIENT_ID=
# AKENEO_SECRET=
# AKENEO_USERNAME=
# AKENEO_PASSWORD=
# AKENEO_CHANNEL=home_cartel
# AKENEO_LOCALE=en_US
# AKENEO_POLL_INTERVAL=45

# =========================================================================
#  State file (where processed-record IDs are persisted between runs)
# =========================================================================
# PROCESSED_STATE_FILE=./processed_records.json
